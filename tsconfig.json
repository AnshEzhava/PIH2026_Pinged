{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/screens/*":    ["src/screens/*"],
      "@/services/*":   ["src/services/*"],
      "@/context/*":    ["src/context/*"],
      "@/types/*":      ["src/types/*"],
      "@/hooks/*":      ["src/hooks/*"],
      "@/utils/*":      ["src/utils/*"],
      "@/navigation/*": ["src/navigation/*"]
    }
  }
}
